rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Portfolio worksheets: one doc `data` per collection (Portfolios, StockPurchases, …)
    match /{collection}/{docId} {
      allow read, write: if request.auth != null
        && collection in [
          'Portfolios',
          'StockPurchases',
          'Dividends',
          'InvestmentLog'
        ]
        && docId == 'data';
    }
  }
}
